{
  "name": "dsh-supertick",
  "version": "0.4.1",
  "description": "DSH-native supertick skills and read-only progress monitoring with managed background jobs",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "skills.mjs",
    "watch.mjs",
    "monitor.mjs",
    "skills/*/SKILL.md",
    "skills/supertick/references/*.MD",
    "skills/supertick/references/ALLOWED-MODELS.json",
    "skills/supertick/scripts/supervisor.py",
    "cordis.patch.yml",
    "README.MD",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "npm pack"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CtrlAltPeach/dsh-supertick.git"
  }
}
